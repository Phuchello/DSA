{
  "name": "dsa-flowlab",
  "version": "0.1.0-p0",
  "description": "DSA FlowLab - Web-first C++ Execution Visualizer for Data Structures & Algorithms",
  "scripts": {
    "start": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start:server": "npm --prefix server start",
    "start:client": "npm --prefix client run preview",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "test": "node tests/runAllTests.js",
    "test:browser": "node tests/browserSmoke.js",
    "test:browser:array": "node tests/browserSmokeArray.js",
    "test:browser:recursion": "node tests/browserSmokeRecursion.js",
    "test:browser:m2-1": "node tests/browserSmokeM2_1.js",
    "test:browser:m2-2": "node tests/browserSmokeM2_2.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "author": "Vo Trong Phuc",
  "license": "MIT"
}
